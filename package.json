{
  "name": "qualia",
  "version": "0.4.0",
  "description": "Qualia Transmission Protocol (QTP) and sensorimotor client for TypeScript and JavaScript",
  "license": "BSD-3-Clause",
  "author": "Afshin T. Darian <qualia@darian.at>",
  "homepage": "https://github.com/ursiform/qualia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ursiform/qualia.git"
  },
  "bugs": {
    "url": "https://github.com/ursiform/qualia/issues"
  },
  "keywords": [
    "qualia",
    "qtp",
    "protocol",
    "sensorimotor",
    "robotics",
    "web-bluetooth",
    "typescript"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schema.json": "./src/qualia/qtp.v1.schema.json",
    "./openapi.json": "./src/qualia/openapi.json"
  },
  "files": [
    "lib/*.js",
    "lib/index.d.ts",
    "src/qualia/qtp.v1.schema.json",
    "PROTOCOL.md",
    "README.md",
    "LICENSE",
    "src/qualia/openapi.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test tests/js/test_qtp.mjs tests/js/test_regressions.mjs",
    "typecheck": "npx --yes --package typescript@5.6.3 tsc --noEmit",
    "build:lite": "jupyter lite build --config lite/jupyter_lite_config.json",
    "serve:lite": "jupyter lite serve --config lite/jupyter_lite_config.json",
    "generate:schema": "python3 tools/schema.py"
  },
  "publishConfig": {
    "access": "public"
  }
}
