    "/api/qtp/step": {
      "post": {
        "operationId": "step",
        "summary": "Integrate one observation and optional preceding physical outcome.",
        "description": "The first request has step 0 and null or absent action and consequence. Each successful request advances the expected step by one. Later action values must match the preceding returned intention; consequence may be null when unavailable. The response echoes the request step and has fallback=false. Invalid requests and sequence conflicts must not advance the session. The percept step is a source frame index and need not equal the decision step. The reference service supports one client per process; restart it to begin a fresh episode. Failed operations are not automatically retried.",
        "x-reference-limit": 2097152,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StepRequest"
              },
              "example": {
                "protocol": "qtp/1.0",
                "step": 0,
                "percept": {
                  "width": 1,
                  "height": 1,
                  "rgb": "DAwY",
                  "step": 0,
                  "phase": "visible",
                  "cue": null
                },
                "action": null,
                "consequence": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One decision from the remote service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemoteResponse"
                }
              }
            }
          },
          "400": {
