  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": ["protocol", "ready"],
        "properties": {
          "protocol": {
            "type": "string",
            "const": "qtp/1.0"
          },
          "ready": {
            "type": "boolean"
          },
          "engine": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_action": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Action"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "detail"],
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "RemoteIntention": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Intention"
          },
          {
            "type": "object",
            "properties": {
              "fallback": {
                "const": false
              }
            }
          }
        ]
      },
      "RemoteResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RemoteIntention"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["intention"],
            "properties": {
              "intention": {
                "$ref": "#/components/schemas/RemoteIntention"
              }
            }
          }
        ]
      },
      "Action": {
        "$ref": "qtp.v1.schema.json#/$defs/Action"
      },
      "Phase": {
