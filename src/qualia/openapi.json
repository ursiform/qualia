                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Step or preceding action conflicts with the current session; no state changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
