{
  "openapi": "3.1.0",
  "info": {
    "title": "Qualia Transmission Protocol",
    "version": "1.0",
    "description": "QTP connects embodied peripherals to decision services. OpenAPI describes the HTTP and message contract; sequential step and preceding-action rules are also normative. The bundled loopback reference service runs a deterministic demonstration policy with synthetic pool readouts. Other services may use different decision policies.",
    "license": {
      "name": "BSD-3-Clause",
      "identifier": "BSD-3-Clause"
    }
  },
